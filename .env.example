# Copy to .env (never commit .env).

# Local dev default is SQLite in the project folder. Production MUST be PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/job_monitor

RECIPIENT_EMAIL=you@example.com

# Leave SMTP_HOST empty to write all emails to ./outbox instead of sending.
# Amazon SES works through its SMTP interface - no extra code:
#   SMTP_HOST=email-smtp.eu-west-1.amazonaws.com  SMTP_PORT=587  SMTP_USE_TLS=true
#   SMTP_USER/SMTP_PASSWORD = SES SMTP credentials,  SMTP_FROM = a verified sender address
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Only used by `fixture` sources (tests / offline demos).
FIXTURE_DIR=fixtures/day1

# Links inside alert emails point here.
PUBLIC_BASE_URL=http://localhost:8000
# Set to true when served over HTTPS (session cookie becomes Secure).
COOKIE_SECURE=false

LOG_LEVEL=INFO
